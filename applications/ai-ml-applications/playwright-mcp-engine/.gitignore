# ==============================================================================
# Playwright MCP Engine - Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/
.npm/

# Build artifacts
dist/
build/
*.tsbuildinfo

# Environment variables & secrets
.env
*.env
*.env.*
!*.env.example
!config/deploy/*.env.example
*.pem
*.key
*.cert
*.pfx

# Playwright runtime files & reports
test-results/
playwright-report/
blob-report/
.playwright/
playwright/.cache/

# Code coverage & test output
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Temporary files
scratch/
tmp/
temp/
