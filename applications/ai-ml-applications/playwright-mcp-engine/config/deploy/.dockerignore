# ==============================================================================
# Playwright MCP Engine - Docker Build Ignore Rules
# ==============================================================================

# Local dependency directories
node_modules/
.pnpm-store/

# Local build artifacts
dist/
build/
*.tsbuildinfo

# Git metadata
.git/
.github/
.gitignore

# Environment configurations and secret keys
.env
*.env
*.env.*
!config/deploy/*.env.example
*.pem
*.key
*.cert
*.pfx

# Testing and Playwright runtime artifacts
test-results/
playwright-report/
blob-report/
.playwright/
coverage/
.nyc_output/

# Logs and runtime caches
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# IDE and OS metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
