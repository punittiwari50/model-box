# ==============================================================================
# Playwright MCP Engine - Environment Configuration Template
# Decoupled microservice configuration for Playwright automation & MCP Server
# ==============================================================================

# Core Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=8940
MCP_PORT=8941

# Concurrency & Watchdog
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_MAX_CONCURRENCY=10
PLAYWRIGHT_MAX_PAGES_PER_CONTEXT=5
STEP_WATCHDOG_TIMEOUT_MS=30000
WORKFLOW_WATCHDOG_TIMEOUT_MS=180000
STUCK_GRACE_PERIOD_MS=3000

# Resilience & Retries
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RESET_MS=30000
CIRCUIT_BREAKER_PROBES=2
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=15000

# AI Connectors (ModelBox Ecosystem - Docker Network: model-box-net)
OLLAMA_BASE_URL=http://ollama-model-service-gpu:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:latest
OLLAMA_TIMEOUT_MS=60000

COMFYUI_BASE_URL=http://comfyui-model-service-gpu:8188
COMFYUI_TIMEOUT_MS=90000
