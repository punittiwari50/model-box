{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "../../dist",
    "rootDir": "../../src/main/typescript",
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/main/typescript/*"],
      "@model-box/model-connector-core": ["../model-connector-core/dist/index.d.ts"],
      "@model-box/model-connector-core/*": ["../model-connector-core/dist/*"],
      "@domain/*": ["src/main/typescript/domain/*"],
      "@strategies/*": ["src/main/typescript/strategies/*"],
      "@adapters/*": ["src/main/typescript/adapters/*"],
      "@client/*": ["src/main/typescript/client/*"],
      "@security/*": ["src/main/typescript/security/*"],
      "@grounding/*": ["src/main/typescript/grounding/*"],
      "@resources/*": ["src/main/resources/*"],
      "@test/*": ["src/test/typescript/*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["../../src/main/typescript/**/*"],
  "exclude": ["../../node_modules", "../../dist", "../../src/test/**/*"]
}
