# ==============================================================================
# ModelBox Connectors Service Microservice Vault Template (*-secure.env)
# COPY THIS FILE TO 'model-box-service-secure.env' AND CONFIGURE SECRETS.
# NEVER COMMIT ACTUAL *-secure.env FILES TO VERSION CONTROL.
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_database_password_here
POSTGRES_DB=model_connectors
API_SECRET_KEY=your_secure_random_api_secret_key_here
COOKIE_SESSION_SECRET=your_secure_random_cookie_token_here
VAULT_ADDR=http://model-connectors-vault:8200
VAULT_TOKEN=modelbox-vault-root-token
