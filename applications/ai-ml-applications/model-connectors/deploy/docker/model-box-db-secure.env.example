# ==============================================================================
# ModelBox Connectors Database Vault Template (*-secure.env)
# COPY THIS FILE TO 'model-box-db-secure.env' AND CONFIGURE SECRETS.
# NEVER COMMIT ACTUAL *-secure.env FILES TO VERSION CONTROL.
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_database_password_here
POSTGRES_DB=model_connectors
VAULT_SECRET_ENGINE=secret
VAULT_DB_SECRET_PATH=secret/modelbox/database
