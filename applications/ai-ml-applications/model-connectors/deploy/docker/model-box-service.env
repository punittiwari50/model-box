# ==============================================================================
# ModelBox Connectors Service Microservice Environment Configuration
# Adheres to externalized container orchestration standard
# Sensitive credentials are provided via vault and *-secure.env files.
# ==============================================================================
SERVICE_CONTAINER_NAME=model-connectors-service
SERVICE_IMAGE_NAME=model-connectors-service:latest
SERVICE_RESTART=unless-stopped
MODEL_CONNECTORS_PORT=8000
SERVICE_INTERNAL_PORT=8000
SERVICE_HEALTHCHECK_INTERVAL=15s
SERVICE_HEALTHCHECK_TIMEOUT=5s
SERVICE_HEALTHCHECK_RETRIES=3
SERVICE_HEALTHCHECK_START_PERIOD=10s

# Vault Container Configuration
VAULT_CONTAINER_NAME=model-connectors-vault
VAULT_IMAGE_NAME=hashicorp/vault:latest
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN_ID=modelbox-vault-root-token

# PostgreSQL Container Configuration (Non-sensitive orchestration variables)
POSTGRES_CONTAINER_NAME=model-connectors-postgres
POSTGRES_IMAGE_NAME=postgres:17-alpine
POSTGRES_RESTART=unless-stopped
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=model-connectors-postgres-data

# Spring & Python Runtime Configuration
SPRING_PROFILES_ACTIVE=docker
APP_HOST=0.0.0.0
APP_PORT=8000
SHARED_NETWORK_NAME=model-box-net

# Model Service Endpoints inside Docker Network (model-box-net)
MODEL_BOX_OLLAMA_URL=http://ollama-model-service-gpu:11434
MODEL_BOX_COMFYUI_URL=http://comfyui-model-service-gpu:8188
MODEL_BOX_SQLITE_PATH=:memory:
