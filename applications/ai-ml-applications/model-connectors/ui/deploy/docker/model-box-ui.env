# ==============================================================================
# ModelBox Connectors UI React / Vite Frontend Environment Configuration
# Adheres to externalized container orchestration standard
# ==============================================================================
UI_CONTAINER_NAME=model-connectors-ui
UI_IMAGE_NAME=model-connectors-ui:latest
UI_RESTART=unless-stopped
MODEL_CONNECTORS_UI_PORT=3000
UI_INTERNAL_PORT=3000
SHARED_NETWORK_NAME=model-box-net

# Node.js & Vite Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
VITE_BACKEND_URL=http://model-connectors-service:8000
