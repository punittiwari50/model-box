{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/main/typescript/*"],
      "@core/*": ["src/main/typescript/core/*"],
      "@controllers/*": ["src/main/typescript/controllers/*"],
      "@services/*": ["src/main/typescript/services/*"],
      "@repositories/*": ["src/main/typescript/repositories/*"],
      "@domain/*": ["src/main/typescript/domain/*"],
      "@resources/*": ["src/main/resources/*"],
      "@test/*": ["src/test/typescript/*"],
      "@test-resources/*": ["src/test/resources/*"]
    },
    "outDir": "../../dist",
    "rootDir": "../../src/main/typescript",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true
  },
  "include": ["../../src/main/typescript/**/*"],
  "exclude": ["../../node_modules", "../../dist", "../../src/test/**/*", "**/*.test.ts"]
}
