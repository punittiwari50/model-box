{
  "name": "gemini-model-connector",
  "version": "1.0.0",
  "description": "Context-aware Node.js server communicating with Google Gemini CLI for conversations, job search analysis, markdown generation, and SQLite audit logging",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p config/typescript/tsconfig.json && tsc-alias -p config/typescript/tsconfig.json && node config/scripts/build/build-resources.js",
    "build:resources": "node config/scripts/build/build-resources.js",
    "start": "node dist/index.js",
    "dev": "tsx watch --tsconfig config/typescript/tsconfig.json src/main/typescript/index.ts",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "test": "tsx --tsconfig config/typescript/tsconfig.test.json --test --test-concurrency=1 src/test/typescript/**/*.test.ts",
    "test:unit": "tsx --tsconfig config/typescript/tsconfig.test.json --test src/test/typescript/unit/**/*.test.ts",
    "test:integration": "tsx --tsconfig config/typescript/tsconfig.test.json --test --test-concurrency=1 src/test/typescript/integration/**/*.test.ts",
    "test:performance": "tsx --tsconfig config/typescript/tsconfig.test.json --test src/test/typescript/performance/**/*.test.ts",
    "test:concurrent": "tsx --tsconfig config/typescript/tsconfig.test.json --test src/test/typescript/concurrent/**/*.test.ts",
    "test:coverage": "tsx --tsconfig config/typescript/tsconfig.test.json --test --test-concurrency=1 --experimental-test-coverage src/test/typescript/**/*.test.ts",
    "docker:build": "docker compose -f config/docker/docker-compose.yml build",
    "docker:run": "docker compose -f config/docker/docker-compose.yml up -d gemini-model-connector",
    "docker:test": "docker compose -f config/docker/docker-compose.yml run --rm gemini-test-runner",
    "docker:verify": "docker compose -f config/docker/docker-compose.yml run --rm gemini-python-verifier",
    "docker:logs": "docker compose -f config/docker/docker-compose.yml logs -f gemini-model-connector",
    "docker:down": "docker compose -f config/docker/docker-compose.yml down"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "chokidar": "^3.6.0"
  },
  "keywords": [
    "gemini",
    "gemini-cli",
    "model-connector",
    "agent",
    "job-search",
    "resume-tailoring",
    "audit-logging",
    "fastapi-node"
  ],
  "author": "ModelBox Team",
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
