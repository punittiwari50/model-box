# Compose interpolation variables (copy to .env for local use)
COMPOSE_OLLAMA_IMAGE=model-box-ollama:latest
COMPOSE_BIND_IP=127.0.0.1
COMPOSE_HOST_PORT=11435
COMPOSE_CONTAINER_PORT=11434

# Shared host/container bind mounts (portable, project-relative storage)
COMPOSE_OLLAMA_MODELS_HOST=./volumes/ollama
COMPOSE_OLLAMA_MODELS_CONTAINER=/models

# Ollama runtime defaults tuned for high concurrency without starving the host
COMPOSE_OLLAMA_HOST=0.0.0.0:11434
COMPOSE_OLLAMA_NO_CLOUD=true
COMPOSE_OLLAMA_NUM_PARALLEL=4
COMPOSE_OLLAMA_MAX_LOADED_MODELS=2
COMPOSE_OLLAMA_MAX_QUEUE=256
COMPOSE_OLLAMA_KEEP_ALIVE=30m
COMPOSE_OLLAMA_CONTEXT_LENGTH=32768

# Container runtime limits
COMPOSE_SHM_SIZE=2g
COMPOSE_CPUS=8
COMPOSE_MEM_LIMIT=20g
COMPOSE_MEM_RESERVATION=12g
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
CUDA_VISIBLE_DEVICES=0
