# Compose interpolation variables (copy to .env for local use)
COMPOSE_OLLAMA_IMAGE=ollama/ollama:latest
COMPOSE_BIND_IP=127.0.0.1
COMPOSE_HOST_PORT=11435
COMPOSE_CONTAINER_PORT=11434

# Shared host/container bind mounts (bidirectional persistent model storage)
COMPOSE_OLLAMA_MODELS_HOST=C:/volume-docker_ollama
COMPOSE_OLLAMA_MODELS_CONTAINER=/models

# Ollama runtime defaults from the enterprise guide
COMPOSE_OLLAMA_HOST=0.0.0.0:11434
COMPOSE_OLLAMA_NO_CLOUD=true
COMPOSE_OLLAMA_NUM_PARALLEL=2
COMPOSE_OLLAMA_MAX_LOADED_MODELS=1
COMPOSE_OLLAMA_MAX_QUEUE=128
COMPOSE_OLLAMA_KEEP_ALIVE=10m
COMPOSE_OLLAMA_CONTEXT_LENGTH=8192

# Container runtime limits
COMPOSE_SHM_SIZE=2g
COMPOSE_CPUS=8
COMPOSE_MEM_LIMIT=24g

# GPU mode settings (optional: uncomment for GPU acceleration)
# Requires NVIDIA Container Toolkit on host and GPU device
# NVIDIA_VISIBLE_DEVICES=0
# NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Note: For GPU mode, use ollama-gpu.env: docker compose --env-file ollama-gpu.env -f compose.gpu.yaml up -d
# For CPU mode, use ollama-cpu.env: docker compose --env-file ollama-cpu.env -f compose.cpu.yaml up -d
