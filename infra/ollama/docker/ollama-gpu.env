COMPOSE_OLLAMA_IMAGE=model-box-ollama:latest
COMPOSE_BIND_IP=127.0.0.1
COMPOSE_HOST_PORT=11435
COMPOSE_CONTAINER_PORT=11434
COMPOSE_OLLAMA_MODELS_HOST=./volumes/ollama
COMPOSE_OLLAMA_MODELS_CONTAINER=/models
COMPOSE_SHM_SIZE=2g
COMPOSE_CPUS=8
COMPOSE_MEM_LIMIT=20g
COMPOSE_MEM_RESERVATION=12g

OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODELS=/models
OLLAMA_NO_CLOUD=true
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_MAX_QUEUE=256
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_LENGTH=32768
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
CUDA_VISIBLE_DEVICES=0