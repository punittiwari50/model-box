COMPOSE_OLLAMA_IMAGE=model-box-ollama:latest
COMPOSE_BIND_IP=127.0.0.1
COMPOSE_HOST_PORT=11435
COMPOSE_CONTAINER_PORT=11434
COMPOSE_OLLAMA_MODELS_HOST=./volumes/ollama
COMPOSE_OLLAMA_MODELS_CONTAINER=/models
COMPOSE_SHM_SIZE=1g
COMPOSE_CPUS=2
COMPOSE_MEM_LIMIT=6g
COMPOSE_MEM_RESERVATION=2g

OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODELS=/models
OLLAMA_NO_CLOUD=true
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=192
OLLAMA_KEEP_ALIVE=20m
OLLAMA_CONTEXT_LENGTH=16384