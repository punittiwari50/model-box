COMPOSE_BIND_IP=127.0.0.1
COMPOSE_HOST_PORT=8189
COMPOSE_CONTAINER_PORT=8188

COMPOSE_COMFYUI_SOURCE_HOST=../../applications/ai-ml-applications/repo_comfyui
COMPOSE_COMFYUI_VOLUME_HOST=./volumes/comfyui
COMPOSE_COMFYUI_WORKFLOWS_HOST=./volumes/comfyui/workflows
COMPOSE_COMFYUI_SKILLS_HOST=./volumes/skills

COMPOSE_SHM_SIZE=4g
COMPOSE_CPUS=10
COMPOSE_MEM_LIMIT=24g
COMPOSE_MEM_RESERVATION=12g

COMFYUI_LISTEN=0.0.0.0
COMFYUI_DISABLE_AUTO_LAUNCH=1
COMFYUI_ENABLE_ASSETS=0
COMFYUI_DATABASE_URL=

POSTGRES_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=5432
POSTGRES_DB=comfyui
POSTGRES_USER=comfyui
POSTGRES_PASSWORD=comfyui
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
CUDA_VISIBLE_DEVICES=0
