FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1

ARG TORCH_VERSION=2.14.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/comfyui

# Build ComfyUI from local cloned source.
COPY applications/ai-ml-applications/repo_comfyui/ /opt/comfyui/

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install --index-url https://download.pytorch.org/whl/cpu torch==${TORCH_VERSION} torchvision torchaudio \
    && python -m pip install -r requirements.txt \
    && python -m pip install PyOpenGL PyOpenGL-accelerate psycopg[binary]

COPY infra/comfyui/docker/entrypoint.sh /opt/comfyui/entrypoint.sh
RUN chmod +x /opt/comfyui/entrypoint.sh

EXPOSE 8188

ENTRYPOINT ["/bin/bash", "/opt/comfyui/entrypoint.sh"]
